---
const {
  server = "netease",
  type = "playlist",
  id,
  fixed = "false",
  mini = "false",
  autoplay = "false",
  order = "list",
  listFolded = "true",
  listMaxHeight = "240px",
} = Astro.props;
---

{id ? (
  <meting-js
    server={server}
    type={type}
    id={id}
    fixed={fixed}
    mini={mini}
    autoplay={autoplay}
    order={order}
    list-folded={listFolded}
    list-max-height={listMaxHeight}
  />
) : (
  <div class="aplayer-empty">?????/?? ID</div>
)}

<style>
  .aplayer-empty {
    padding: 12px 14px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.35);
    color: #666;
    font-size: 0.85rem;
    text-align: center;
  }
</style>
