---
import weeklyData from "../data/pixiv-weekly-top10.json";

const items = Array.isArray(weeklyData?.items) ? weeklyData.items : [];
const itemsWithSources = items.map((item) => {
  const original = String(item.originalThumbnailUrl ?? "");
  const pximgMirror = original
    ? original
        .replace("https://i.pximg.net/", "https://i.pixiv.re/")
        .replace(/\/c\/\d+x\d+\//, "/")
    : "";
  const pixivCat = item.id ? `https://pixiv.cat/${item.id}.jpg` : "";
  const sources = [
    String(item.thumbnailUrl ?? ""),
    ...(Array.isArray(item.fallbackThumbnailUrls) ? item.fallbackThumbnailUrls.map(String) : []),
    pximgMirror,
    pixivCat,
  ].filter(Boolean);
  return { ...item, imageSources: Array.from(new Set(sources)) };
});
---

<section class="pixiv-weekly" aria-label="Pixiv weekly illustration ranking">
  {itemsWithSources.length === 0 ? (
    <p class="pixiv-empty">No data yet. Run `npm run update:pixiv-weekly` first.</p>
  ) : (
    <div class="pixiv-slider" data-pixiv-slider>
      <div class="pixiv-viewport">
        <button class="pixiv-nav prev" type="button" aria-label="Previous image" data-prev>&lt;</button>
        <ul class="pixiv-track" data-track>
          {itemsWithSources.map((item) => (
            <li class="pixiv-slide">
              <a href={item.artworkUrl} target="_blank" rel="noreferrer" title={item.title}>
                <img
                  src={item.imageSources[0]}
                  alt={item.title}
                  loading="lazy"
                  data-fallbacks={JSON.stringify(item.imageSources)}
                  data-fallback-index="0"
                />
              </a>
            </li>
          ))}
        </ul>
        <button class="pixiv-nav next" type="button" aria-label="Next image" data-next>&gt;</button>
      </div>
    </div>
  )}
</section>

<style>
  .pixiv-weekly {
    --pixiv-card-w: 260px;
    --pixiv-card-h: 440px;
    margin-top: 0;
    width: fit-content;
    max-width: 100%;
    padding: 0;
    border-radius: 18px;
    background: transparent;
    border: none;
    backdrop-filter: none;
  }

  .pixiv-empty {
    margin: 0;
    color: #5e6b84;
  }

  .pixiv-slider {
    display: block;
    width: fit-content;
    perspective: 1000px;
  }

  .pixiv-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    border: none;
    border-radius: 10px;
    height: 36px;
    width: 36px;
    cursor: pointer;
    background: rgba(18, 24, 37, 0.42);
    color: #fff;
    font-size: 1rem;
    line-height: 1;
    opacity: 0;
    transition: opacity 220ms ease, background-color 220ms ease;
    z-index: 3;
  }

  .pixiv-nav.prev {
    left: 8px;
  }

  .pixiv-nav.next {
    right: 8px;
  }

  .pixiv-viewport:hover .pixiv-nav,
  .pixiv-viewport:focus-within .pixiv-nav {
    opacity: 1;
  }

  .pixiv-nav:hover,
  .pixiv-nav:focus-visible {
    background: rgba(18, 24, 37, 0.62);
  }

  .pixiv-viewport {
    --rotate-x: 0deg;
    --rotate-y: 0deg;
    width: var(--pixiv-card-w);
    overflow: hidden;
    margin: 0 auto;
    border-radius: 18px;
    position: relative;
    isolation: isolate;
    transform: rotateX(var(--rotate-x)) rotateY(var(--rotate-y));
    transform-style: preserve-3d;
    transition: transform 420ms cubic-bezier(0.22, 1.12, 0.36, 1);
  }

  .pixiv-track {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
    width: var(--pixiv-card-w);
    height: var(--pixiv-card-h);
  }

  .pixiv-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 420ms ease;
    will-change: opacity;
    backface-visibility: hidden;
  }

  .pixiv-slide.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    z-index: 1;
  }

  .pixiv-slide a {
    display: block;
    width: var(--pixiv-card-w);
    height: var(--pixiv-card-h);
    border-radius: 18px;
    overflow: hidden;
    background: #0f1115;
    border: none;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
    backdrop-filter: blur(10px);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .pixiv-slide a:hover,
  .pixiv-slide a:focus-visible {
    transform: none;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
  }

  .pixiv-slide img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    background: #0f1115;
  }

  @media (max-width: 768px) {
    .pixiv-weekly {
      --pixiv-card-w: min(260px, calc(100vw - 104px));
      --pixiv-card-h: 380px;
      margin-top: 0;
    }

    .pixiv-nav {
      width: 32px;
      height: 32px;
    }

    .pixiv-viewport { width: var(--pixiv-card-w); }
  }

  @media (prefers-reduced-motion: reduce) {
    .pixiv-viewport {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  const setupPixivSlider = () => {
    const root = document.querySelector("[data-pixiv-slider]");
    if (!(root instanceof HTMLElement)) return;
    if (root.dataset.ready === "true") return;
    root.dataset.ready = "true";

    const track = root.querySelector("[data-track]");
    const prevBtn = root.querySelector("[data-prev]");
    const nextBtn = root.querySelector("[data-next]");
    if (!(track instanceof HTMLElement)) return;

    const slides = Array.from(track.querySelectorAll(".pixiv-slide"));
    if (slides.length === 0) return;
    const viewport = root.querySelector(".pixiv-viewport");
    if (!(viewport instanceof HTMLElement)) return;

    let index = 0;
    let timer = 0;
    const intervalMs = 5000;

    const render = () => {
      slides.forEach((slide, i) => {
        slide.classList.toggle("is-active", i === index);
      });
    };

    const go = (nextIndex) => {
      const total = slides.length;
      index = ((nextIndex % total) + total) % total;
      render();
    };

    const resetTimer = () => {
      if (timer) window.clearInterval(timer);
      timer = window.setInterval(() => {
        go(index + 1);
      }, intervalMs);
    };

    prevBtn?.addEventListener("click", () => {
      go(index - 1);
      resetTimer();
    });

    nextBtn?.addEventListener("click", () => {
      go(index + 1);
      resetTimer();
    });

    root.addEventListener("mouseenter", () => {
      if (timer) window.clearInterval(timer);
    });

    root.addEventListener("mouseleave", () => {
      resetTimer();
    });

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        if (timer) window.clearInterval(timer);
      } else {
        resetTimer();
      }
    });

    const images = Array.from(root.querySelectorAll("img[data-fallbacks]"));
    images.forEach((img) => {
      const onError = () => {
        const raw = img.getAttribute("data-fallbacks");
        if (!raw) return;
        let list = [];
        try {
          list = JSON.parse(raw);
        } catch {
          return;
        }
        const current = Number.parseInt(img.getAttribute("data-fallback-index") ?? "0", 10);
        const nextIndex = Number.isNaN(current) ? 1 : current + 1;
        if (!Array.isArray(list) || nextIndex >= list.length) return;
        img.setAttribute("data-fallback-index", String(nextIndex));
        img.src = list[nextIndex];
      };
      img.addEventListener("error", onError);
    });

    const maxTilt = 8;
    const followStrength = 0.14;
    const restThreshold = 0.02;
    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;
    let rafId = 0;

    const renderTilt = () => {
      viewport.style.setProperty("--rotate-x", `${currentX}deg`);
      viewport.style.setProperty("--rotate-y", `${currentY}deg`);
    };

    const animateTilt = () => {
      currentX += (targetX - currentX) * followStrength;
      currentY += (targetY - currentY) * followStrength;
      renderTilt();

      const dx = Math.abs(targetX - currentX);
      const dy = Math.abs(targetY - currentY);
      if (dx > restThreshold || dy > restThreshold) {
        rafId = window.requestAnimationFrame(animateTilt);
        return;
      }
      currentX = targetX;
      currentY = targetY;
      renderTilt();
      rafId = 0;
    };

    const ensureTiltAnimation = () => {
      if (rafId !== 0) return;
      rafId = window.requestAnimationFrame(animateTilt);
    };

    viewport.addEventListener("mousemove", (event) => {
      const rect = viewport.getBoundingClientRect();
      const px = (event.clientX - rect.left) / rect.width - 0.5;
      const py = (event.clientY - rect.top) / rect.height - 0.5;
      targetX = -py * maxTilt;
      targetY = px * maxTilt;
      ensureTiltAnimation();
    });

    viewport.addEventListener("mouseleave", () => {
      targetX = 0;
      targetY = 0;
      ensureTiltAnimation();
    });

    render();
    resetTimer();
  };

  setupPixivSlider();
  document.addEventListener("astro:page-load", setupPixivSlider);
</script>
