---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import PhotoCarousel from "./PhotoCarousel.astro";

type Props = {
	dir: string;
	altPrefix?: string;
	variant?: "carousel" | "grid";
	widths?: number[];
	formats?: Array<"webp" | "avif" | "jpeg" | "png">;
	showCaption?: boolean;
	showControls?: boolean;
	showDots?: boolean;
	blankCaptionFilenames?: string[];
};

const {
	dir,
	altPrefix = "Photo",
	variant = "carousel",
	widths = [480, 960, 1440],
	formats = ["webp", "avif", "jpeg"],
	showCaption = false,
	showControls = true,
	showDots = true,
	blankCaptionFilenames = [],
} = Astro.props as Props;

const modules = import.meta.glob("../assets/**/*.{jpg,jpeg,png,webp}", {
	eager: true,
});

const normalize = (value: string) => value.replace(/\\/g, "/");
const normalizeDir = (value: string) => value.replace(/^\/+|\/+$/g, "");

const dirNormalized = normalizeDir(dir);
const prefix = `/assets/${dirNormalized}/`;
const hiddenCaptionSet = new Set(blankCaptionFilenames);

const resolveCaption = (filename: string) => {
	if (!filename || hiddenCaptionSet.has(filename)) {
		return "";
	}
	return filename;
};

const images = Object.entries(modules)
	.filter(([path]) => normalize(path).includes(prefix))
	.sort(([a], [b]) => a.localeCompare(b))
	.map(([path, mod], index) => {
		const filename = normalize(path).split("/").pop() ?? "";
		return {
			src: (mod as { default: ImageMetadata }).default,
			alt: `${altPrefix} ${index + 1}`,
			filename,
			caption: resolveCaption(filename),
		};
	});
---

{dirNormalized ? (
	variant === "carousel" ? (
		<PhotoCarousel
			images={images}
			altPrefix={altPrefix}
			showControls={showControls}
			showDots={showDots}
			showCaption={showCaption}
			widths={widths}
			formats={formats}
		/>
	) : (
		<div class="asset-gallery">
			{images.map((img) => (
				<figure class="asset-gallery__item">
					<Image
						src={img.src}
						alt={img.alt}
						widths={widths}
						formats={formats}
						loading="lazy"
						decoding="async"
					/>
					{showCaption && (
						<figcaption class:list={["asset-gallery__caption", { "is-empty": !resolveCaption(img.filename) }]}>
							{img.caption || "\u00a0"}
						</figcaption>
					)}
				</figure>
			))}
		</div>
	)
) : (
	<div class="asset-gallery__empty">Missing `dir` prop.</div>
)}

<style>
	.asset-gallery {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1rem;
		margin: 1.5rem 0;
	}

	.asset-gallery__item {
		margin: 0;
	}

	.asset-gallery__caption {
		margin-top: 0.5rem;
		text-align: center;
		font-size: 0.9rem;
		color: rgba(0, 0, 0, 0.42);
		line-height: 1.3;
		word-break: break-all;
	}

	.asset-gallery__caption.is-empty {
		color: transparent;
	}

	.asset-gallery :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 12px;
	}

	.asset-gallery__empty {
		padding: 0.75rem 1rem;
		border: 1px dashed rgba(0, 0, 0, 0.2);
		border-radius: 12px;
		color: #666;
	}
</style>
