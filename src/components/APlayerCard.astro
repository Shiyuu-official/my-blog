---
type Props = {
	id: string;
	title?: string;
	subtitle?: string;
	server?: "netease" | "tencent" | "kugou" | "xiami" | "baidu";
	type?: "song" | "playlist" | "album" | "search" | "artist";
	theme?: string;
	mini?: boolean;
	autoplay?: boolean;
	loop?: "all" | "one" | "none";
	order?: "list" | "random";
	volume?: number;
	listFolded?: boolean;
	listMaxHeight?: string;
};

const {
	id,
	title = "Music",
	subtitle,
	server = "netease",
	type = "playlist",
	theme = "#1f2d3d",
	mini = false,
	autoplay = false,
	loop = "all",
	order = "list",
	volume = 0.7,
	listFolded = false,
	listMaxHeight = "360px",
} = Astro.props as Props;
---

<div class="aplayer-card">
	<header class="aplayer-card__header">
		<div>
			<h3 class="aplayer-card__title">{title}</h3>
			{subtitle && <p class="aplayer-card__subtitle">{subtitle}</p>}
		</div>
	</header>
	<div class="aplayer-card__body">
		<meting-js
			server={server}
			type={type}
			id={id}
			theme={theme}
			mini={mini ? "true" : "false"}
			autoplay={autoplay ? "true" : "false"}
			loop={loop}
			order={order}
			volume={volume}
			list-folded={listFolded ? "true" : "false"}
			list-max-height={listMaxHeight}
		></meting-js>
	</div>
</div>

<link
	rel="stylesheet"
	href="https://cdn.jsdelivr.net/npm/aplayer@1.10.1/dist/APlayer.min.css"
/>
<script src="https://cdn.jsdelivr.net/npm/aplayer@1.10.1/dist/APlayer.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/meting@2/dist/Meting.min.js"></script>

<style>
	.aplayer-card {
		margin: 1.5rem 0;
		padding: 1.25rem 1.5rem;
		border-radius: 16px;
		background: rgba(255, 255, 255, 0.92);
		border: 1px solid rgba(31, 45, 61, 0.1);
		box-shadow: 0 10px 30px rgba(31, 45, 61, 0.08);
	}

	.aplayer-card__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 0.75rem;
	}

	.aplayer-card__title {
		margin: 0;
		font-size: 1.15rem;
	}

	.aplayer-card__subtitle {
		margin: 0.15rem 0 0;
		color: #6b7280;
		font-size: 0.95rem;
	}

	.aplayer-card__body :global(.aplayer) {
		box-shadow: none;
		border-radius: 12px;
		background: #f8fafc;
	}

	.aplayer-card__body :global(.aplayer .aplayer-list) {
		border-top: 1px solid rgba(31, 45, 61, 0.12);
	}

	@media (max-width: 720px) {
		.aplayer-card {
			padding: 1rem;
		}
	}
</style>
