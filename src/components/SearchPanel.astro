---
const { placeholder = "搜索标题 / 副标题 / 标签" } = Astro.props;
---

<div class="search-panel" data-search-scope>
  <div class="search-card">
    <input
      data-search-input
      type="search"
      placeholder={placeholder}
      aria-label="搜索文章"
    />
    <button type="button" class="search-icon" data-search-trigger aria-label="执行搜索">
      <i class="fa-solid fa-magnifying-glass"></i>
    </button>
  </div>
</div>

<script type="module">
  const normalize = (value) => value.toLowerCase().trim();

  const setupSearchPanels = () => {
    const scopes = document.querySelectorAll("[data-search-scope]");

    scopes.forEach((scope) => {
      if (scope.dataset.searchBound === "true") return;
      scope.dataset.searchBound = "true";

      const input = scope.querySelector("[data-search-input]");
      const trigger = scope.querySelector("[data-search-trigger]");
      const cards = Array.from(document.querySelectorAll(".main .post-card"));

      if (!(input instanceof HTMLInputElement)) return;

      const runSearch = () => {
        const query = normalize(input.value);
        cards.forEach((card) => {
          const title = card.dataset.title ?? "";
          const desc = card.dataset.desc ?? "";
          const tags = card.dataset.tags ?? "";
          const haystack = normalize(`${title} ${desc} ${tags}`);
          card.style.display = haystack.includes(query) ? "" : "none";
        });
      };

      input.addEventListener("keydown", (event) => {
        if (event.key !== "Enter") return;
        event.preventDefault();
        runSearch();
      });

      if (trigger instanceof HTMLButtonElement) {
        trigger.addEventListener("click", runSearch);
      }
    });
  };

  setupSearchPanels();
  document.addEventListener("astro:page-load", setupSearchPanels);
</script>

<style>
  .search-panel {
    width: 100%;
  }

  .search-card {
    background: rgba(255, 255, 255, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.35);
    backdrop-filter: blur(10px);
    border-radius: 16px;
    padding: 12px 14px;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .search-card input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: #333;
  }

  .search-icon {
    all: unset;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    cursor: pointer;
    opacity: 0.6;
  }
</style>
