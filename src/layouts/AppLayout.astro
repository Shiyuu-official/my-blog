---
import BaseHead from "../components/BaseHead.astro";
import Sidebar from "../components/Sidebar.astro";
import GlobalMusicPlayer from "../components/GlobalMusicPlayer.astro";
import { ClientRouter } from "astro:transitions";
const { title = "", description = "" } = Astro.props;
---

<html lang="zh-CN">
  <head>
    <BaseHead title={title} description={description} />
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <div class="app">
      <aside class="sidebar">
        <Sidebar />
      </aside>

      <main class="main">
        <div class="main-inner" transition:name="main-content">
          <slot />
        </div>
      </main>

      <aside class="rightbar">
        <div class="rightbar-inner">
          <div class="rightbar-top">
            <slot name="right" />
          </div>
          <div class="rightbar-bottom">
            <slot name="right-bottom" />
          </div>
        </div>
      </aside>
    </div>
    <GlobalMusicPlayer />
  </body>
</html>

<style>
  html,
  body {
    height: 100%;
    margin: 0;
    overflow-y: auto;
  }

  .app {
    display: grid;
    grid-template-columns: minmax(200px, 240px) minmax(0, 1fr) minmax(240px, 320px);
    min-height: 100vh;
    width: min(100vw, 1660px);
    margin: 0 auto;
    padding: 16px 8px;
    box-sizing: border-box;
  }

  .sidebar {
    position: sticky;
    top: 16px;
    align-self: start;
    height: calc(100vh - 32px);
    overflow: hidden;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .sidebar::-webkit-scrollbar {
    display: none;
  }

  .main {
    height: 100%;
    overflow: visible;
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 24px 24px 32px 24px;
    min-width: 0;
    box-sizing: border-box;
  }

  .main-inner {
    min-height: 100%;
    box-sizing: border-box;
  }

  ::view-transition-old(main-content),
  ::view-transition-new(main-content) {
    animation-duration: 260ms;
    animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
  }

  ::view-transition-old(main-content) {
    animation-name: main-content-out;
  }

  ::view-transition-new(main-content) {
    animation-name: main-content-in;
  }

  @keyframes main-content-out {
    from {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
    to {
      opacity: 0;
      transform: translateY(8px);
      filter: blur(1.5px);
    }
  }

  @keyframes main-content-in {
    from {
      opacity: 0;
      transform: translateY(10px);
      filter: blur(1.5px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(main-content),
    ::view-transition-new(main-content) {
      animation-duration: 1ms;
    }
  }

  .rightbar {
    position: sticky;
    top: 16px;
    align-self: start;
    height: calc(100vh - 32px);
    overflow: hidden;
    --rightbar-top-min-height: 240px;
    min-width: 0;
  }

  .rightbar-inner {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px 8px 32px 0;
    box-sizing: border-box;
    min-height: calc(100vh - 32px);
    min-width: 0;
  }

  .rightbar-top {
    flex: 0 1 auto;
    min-height: 0;
    min-width: 0;
  }

  .rightbar-bottom {
    flex: 1;
    display: flex;
    align-items: flex-start;
    min-width: 0;
  }

  .rightbar-inner > * {
    width: 100%;
  }

  @media (max-width: 1100px) {
    .app {
      grid-template-columns: minmax(180px, 220px) minmax(0, 1fr) minmax(200px, 240px);
    }
  }

  @media (max-width: 900px) {
    .app {
      grid-template-columns: 1fr;
    }

    .sidebar,
    .rightbar {
      position: static;
      height: auto;
    }

    .rightbar {
      order: 3;
    }
  }
</style>
