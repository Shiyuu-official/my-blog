---
import AppLayout from "./AppLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import type { ImageMetadata } from "astro";

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  categoryLabel,
  wordCount,
  postId,
  tags,
  tocHeadings = [],
} = Astro.props;

const placeholderModules = import.meta.glob(
  "../assets/default-cover/*.{jpg,jpeg,png,webp}",
  { eager: true },
);
const placeholders = Object.values(placeholderModules).map(
  (mod) => (mod as { default: ImageMetadata }).default,
);
const pickPlaceholder = (id) => {
  if (!id || placeholders.length == 0) return undefined;
  let hash = 0;
  for (let i = 0; i < id.length; i += 1) {
    hash = (hash * 31 + id.charCodeAt(i)) >>> 0;
  }
  return placeholders[hash % placeholders.length];
};
const coverImage = heroImage ?? pickPlaceholder(postId);
---

<AppLayout title={title} description={description}>
  {tocHeadings.length > 0 && (
    <nav class="toc-card" slot="right" aria-label="文章目录">
      <h2 class="toc-title">目录</h2>
      <ol class="toc-list">
        {tocHeadings.map((heading) => (
          <li>
            <a href={`#${heading.slug}`} data-toc-link>
              {heading.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )}
  <article class="post">
    <header class="post-header">
      {coverImage && (
        <div
          class="hero-frame"
          style={`--cover-url: url('${coverImage.src}');`}
        >
          <img class="hero" src={coverImage.src} alt={title} loading="eager" />
        </div>
      )}

      <div class="post-header-text">
        <h1 class="post-title">{title}</h1>

        <div class="post-meta">
          <span class="meta-item">
            <i class="fa-regular fa-calendar-days" aria-hidden="true"></i>
            <FormattedDate date={pubDate} format="ymd" />
          </span>
          {updatedDate && (
            <span class="meta-item">
              <i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i>
              <FormattedDate date={updatedDate} format="ymd" />
            </span>
          )}
          {categoryLabel && (
            <span class="meta-item">
              <i class="fa-regular fa-folder" aria-hidden="true"></i>
              {categoryLabel}
            </span>
          )}
          {wordCount != null && (
            <span class="meta-item">
              <i class="fa-regular fa-file-lines" aria-hidden="true"></i>
              约 {wordCount} 字
            </span>
          )}
        </div>
        {tags?.length > 0 && (
          <div class="post-tags">
            {tags.map((tag) => (
              <span class="post-tag" title={tag}>{tag}</span>
            ))}
          </div>
        )}
      </div>
    </header>

<div class="post-content markdown-body">
  <slot />
</div>
  </article>
</AppLayout>

<script>
  const headingHighlightClass = "toc-heading-target";

  const animateHeadingJump = (hash, pushHistory = false) => {
    if (!hash) return;

    const decodedHash = decodeURIComponent(hash);
    const target = document.querySelector(decodedHash);
    if (!(target instanceof HTMLElement)) return;

    if (pushHistory) {
      history.pushState(null, "", decodedHash);
    }

    target.scrollIntoView({
      behavior: "smooth",
      block: "start",
    });

    target.classList.remove(headingHighlightClass);
    void target.offsetWidth;
    target.classList.add(headingHighlightClass);

    const previousTimerId = target.dataset.tocHighlightTimer;
    if (previousTimerId) {
      window.clearTimeout(Number(previousTimerId));
    }

    const timerId = window.setTimeout(() => {
      target.classList.remove(headingHighlightClass);
      delete target.dataset.tocHighlightTimer;
    }, 1400);

    target.dataset.tocHighlightTimer = String(timerId);
  };

  document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]").forEach((link) => {
    link.addEventListener("click", (event) => {
      const href = link.getAttribute("href");
      if (!href?.startsWith("#")) return;

      event.preventDefault();
      animateHeadingJump(href, true);
    });
  });

  window.addEventListener("hashchange", () => {
    animateHeadingJump(window.location.hash);
  });
</script>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  .post {
    max-width: 72ch;
    margin: 0 auto;
    padding: 2.5rem 1.25rem;
    min-height: calc(100vh - 150px);
    background: rgba(255, 255, 255, 0.9);
    border-radius: 18px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
    backdrop-filter: blur(10px);
  }

  .post-title {
    font-size: 2rem;
    line-height: 1.2;
    margin: 0;
  }

  .post-meta {
    margin-top: 0.75rem;
    opacity: 0.75;
    font-size: 0.95rem;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 16px;
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }

  .post-tags {
    margin-top: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .post-tag {
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(0, 0, 0, 0.06);
    font-size: 0.8rem;
    color: #555;
  }

  .hero-frame {
    margin: -2.5rem -1.25rem 1.5rem -1.25rem;
    width: calc(100% + 2.5rem);
    height: 260px;
    border-radius: 18px 18px 0 0;
    overflow: hidden;
    background-image: var(--cover-url);
    background-size: cover;
    background-position: center;
  }

  .hero {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .post-content {
    margin-top: 2rem;
  }

  .toc-card {
    background: rgba(255, 255, 255, 0.58);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 16px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 0.9rem 1rem;
    max-height: min(60vh, 520px);
    overflow: auto;
  }

  .toc-title {
    margin: 0 0 0.7rem;
    font-size: 1rem;
    line-height: 1.3;
  }

  .toc-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .toc-list a {
    display: block;
    color: #2f3744;
    text-decoration: none;
    font-size: 0.93rem;
    line-height: 1.45;
    border-radius: 8px;
    padding: 0.25rem 0.45rem;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .toc-list a:hover {
    background: rgba(255, 255, 255, 0.55);
    color: #1e6fcb;
  }

  :global(.markdown-body :is(h2, h3)[id]) {
    scroll-margin-top: 1.5rem;
    transition:
      background-color 0.45s ease,
      box-shadow 0.45s ease,
      transform 0.45s ease;
  }

  :global(.markdown-body :is(h2, h3)[id].toc-heading-target) {
    background: linear-gradient(90deg, rgba(30, 111, 203, 0.14), rgba(30, 111, 203, 0));
    box-shadow: 0 0 0 10px rgba(30, 111, 203, 0.08);
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }

    :global(.markdown-body :is(h2, h3)[id]) {
      transition: none;
    }
  }
</style>
