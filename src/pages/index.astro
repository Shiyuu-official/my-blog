---
import AppLayout from "../layouts/AppLayout.astro";
import WeeklyPixivCarousel from "../components/WeeklyPixivCarousel.astro";
---

<AppLayout title="首页" description="首页">
  <section class="home-panels">
  <section class="home-todo">
    <div class="todo-backdrop" data-todo-backdrop></div>
    <article
      class="todo-card"
      data-todo-card
      role="button"
      tabindex="0"
      aria-expanded="false"
      aria-controls="todo-details"
    >
      <header class="todo-head">
        <p class="todo-kicker">Today Plan</p>
        <h1>Todo</h1>
      </header>

      <section class="todo-details" id="todo-details" data-todo-details hidden>
        <details class="todo-group" open>
          <summary>完成博客首页</summary>
          <ul>
            <li>todo页面</li>
            <li>力扣每日一题？</li>
            <li>日历（实现ui动效）</li>
          </ul>
        </details>
      </section>
    </article>
  </section>
  <section class="home-pixiv">
    <WeeklyPixivCarousel />
  </section>
  <section class="home-link">
    <a
      class="home-link-card"
      data-link-card
      href="https://www.nowcoder.com/exam/oj?questionJobId=10&subTabName=online_coding_page"
      target="_blank"
      rel="noreferrer"
      aria-label="打开牛客在线编程题库"
    >
      <div class="home-link-card__inner">
        <div class="home-link-card__terminal" aria-hidden="true">
          <div class="home-link-card__terminal-bar">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <div class="home-link-card__terminal-screen">
            <p class="home-link-card__prompt">$ oj session --job frontend</p>
            <p class="home-link-card__line"><span>Question</span><strong>#010</strong></p>
            <p class="home-link-card__line"><span>Status</span><strong>Ready</strong></p>
            <p class="home-link-card__line"><span>Mode</span><strong>Practice</strong></p>
            <div class="home-link-card__code">
              <span style="--line-width: 78%"></span>
              <span style="--line-width: 58%"></span>
              <span style="--line-width: 86%"></span>
              <span style="--line-width: 44%"></span>
            </div>
          </div>
        </div>
        <div class="home-link-card__content">
          <p class="home-link-card__kicker">Practice</p>
          <h2>牛客题库</h2>
          <p class="home-link-card__desc">像打开终端一样进入在线编程题库，先刷题，样式后面再继续收。</p>
          <span class="home-link-card__cta">Open Nowcoder</span>
        </div>
      </div>
    </a>
  </section>
  </section>
</AppLayout>

<style>
  .home-panels {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 28px;
    flex-wrap: nowrap;
  }

  .home-todo {
    position: relative;
    min-height: 0;
    padding: 0;
    perspective: 1000px;
    display: flex;
    justify-content: center;
  }

  .home-pixiv {
    display: flex;
    justify-content: center;
  }

  .home-link {
    perspective: 1000px;
    display: flex;
    justify-content: center;
  }

  .todo-backdrop {
    position: fixed;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    background: transparent;
    transition: opacity 460ms cubic-bezier(0.22, 1, 0.36, 1);
    z-index: 12;
  }

  .todo-backdrop.is-active {
    opacity: 1;
    pointer-events: auto;
    background: transparent;
  }

  .home-link-card {
    --rotate-x: 0deg;
    --rotate-y: 0deg;
    overflow: hidden;
    width: 260px;
    height: 440px;
    box-sizing: border-box;
    display: block;
    position: relative;
    border-radius: 24px;
    border: 1px solid rgba(255, 255, 255, 0.4);
    background: transparent;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
    color: inherit;
    text-decoration: none;
    transform: rotateX(var(--rotate-x)) rotateY(var(--rotate-y));
    transform-style: preserve-3d;
    transition:
      transform 520ms cubic-bezier(0.22, 1.12, 0.36, 1),
      box-shadow 260ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .home-link-card::before,
  .home-link-card::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .home-link-card::before {
    background:
      linear-gradient(rgba(116, 255, 214, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(116, 255, 214, 0.05) 1px, transparent 1px);
    background-size: 100% 26px, 26px 100%;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.95), rgba(0, 0, 0, 0.25));
  }

  .home-link-card::after {
    inset: auto -25% 18%;
    height: 120px;
    background: radial-gradient(circle at center, rgba(76, 255, 198, 0.22), transparent 68%);
    filter: blur(24px);
    opacity: 0.72;
    transform: translateX(-18%);
    animation: terminal-glow 6.8s ease-in-out infinite;
  }

  .home-link-card:hover,
  .home-link-card:focus-visible {
    border-color: rgba(34, 58, 111, 0.34);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.14),
      0 14px 30px rgba(9, 12, 20, 0.08);
  }

  .home-link-card:focus-visible {
    outline: 2px solid #223a6f;
    outline-offset: 3px;
  }

  .home-link-card__inner {
    position: relative;
    z-index: 1;
    height: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    padding: 28px 22px 22px;
  }

  .home-link-card__terminal {
    position: relative;
    border: 1px solid rgba(135, 255, 216, 0.2);
    border-radius: 16px;
    background: linear-gradient(180deg, rgba(8, 18, 18, 0.78), rgba(9, 17, 23, 0.55));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 12px 28px rgba(0, 0, 0, 0.14);
    overflow: hidden;
  }

  .home-link-card__terminal::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, transparent 0%, rgba(126, 255, 214, 0.08) 48%, transparent 100%);
    transform: translateX(-120%);
    animation: terminal-scan 5.6s linear infinite;
  }

  .home-link-card__terminal-bar {
    display: flex;
    gap: 0.35rem;
    align-items: center;
    padding: 0.8rem 0.9rem;
    border-bottom: 1px solid rgba(135, 255, 216, 0.12);
    background: rgba(255, 255, 255, 0.03);
  }

  .home-link-card__terminal-bar span {
    width: 0.56rem;
    height: 0.56rem;
    border-radius: 999px;
    background: rgba(213, 255, 245, 0.4);
  }

  .home-link-card__terminal-bar span:nth-child(1) {
    background: rgba(255, 115, 115, 0.7);
  }

  .home-link-card__terminal-bar span:nth-child(2) {
    background: rgba(255, 204, 102, 0.72);
  }

  .home-link-card__terminal-bar span:nth-child(3) {
    background: rgba(88, 214, 141, 0.72);
  }

  .home-link-card__terminal-screen {
    padding: 0.95rem 1rem 1rem;
    color: #b8ffe6;
    font-family: "Consolas", "SFMono-Regular", "Menlo", monospace;
  }

  .home-link-card__prompt,
  .home-link-card__line {
    margin: 0;
    font-size: 0.76rem;
    line-height: 1.55;
  }

  .home-link-card__prompt {
    color: rgba(184, 255, 230, 0.92);
    margin-bottom: 0.65rem;
  }

  .home-link-card__line {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    color: rgba(184, 255, 230, 0.7);
  }

  .home-link-card__line strong {
    color: #effff8;
    font-weight: 600;
  }

  .home-link-card__code {
    display: grid;
    gap: 0.48rem;
    margin-top: 0.95rem;
  }

  .home-link-card__code span {
    display: block;
    width: var(--line-width);
    height: 0.38rem;
    border-radius: 999px;
    background: linear-gradient(90deg, rgba(130, 255, 219, 0.75), rgba(130, 255, 219, 0.14));
  }

  .home-link-card__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    padding-top: 1.15rem;
  }

  .home-link-card__kicker {
    margin: 0;
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(29, 45, 76, 0.72);
  }

  .home-link-card h2 {
    margin: 0.25rem 0 0;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    line-height: 1.05;
  }

  .home-link-card__desc {
    margin: auto 0 0;
    line-height: 1.7;
    color: rgba(23, 29, 42, 0.72);
  }

  .home-link-card__cta {
    display: inline-flex;
    align-items: center;
    margin-top: 1.25rem;
    font-size: 0.92rem;
    color: rgba(29, 45, 76, 0.9);
  }

  .home-link-card__cta::after {
    content: "->";
    margin-left: 0.45rem;
  }

  @keyframes terminal-scan {
    0% {
      transform: translateX(-120%);
    }
    100% {
      transform: translateX(120%);
    }
  }

  @keyframes terminal-glow {
    0%,
    100% {
      transform: translateX(-18%);
      opacity: 0.52;
    }
    50% {
      transform: translateX(10%);
      opacity: 0.86;
    }
  }

  .todo-card {
    --rotate-x: 0deg;
    --rotate-y: 0deg;
    position: relative;
    z-index: 15;
    width: 260px;
    height: 440px;
    box-sizing: border-box;
    padding: 28px 22px 22px;
    border-radius: 24px;
    border: 1px solid rgba(255, 255, 255, 0.42);
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.45), rgba(237, 242, 247, 0.28));
    box-shadow: 0 16px 36px rgba(9, 12, 20, 0.2);
    cursor: pointer;
    transform: rotateX(var(--rotate-x)) rotateY(var(--rotate-y));
    transform-style: preserve-3d;
    transition:
      transform 520ms cubic-bezier(0.22, 1.12, 0.36, 1),
      box-shadow 340ms cubic-bezier(0.22, 1, 0.36, 1),
      width 420ms cubic-bezier(0.22, 1, 0.36, 1),
      padding 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .todo-card:focus-visible {
    outline: 2px solid #223a6f;
    outline-offset: 3px;
  }

  .todo-card:hover {
    box-shadow: 0 22px 48px rgba(9, 12, 20, 0.26);
  }

  .todo-card.is-expanded {
    width: min(100%, 440px);
    min-height: 360px;
    padding-bottom: 26px;
    transform: none;
    box-shadow: 0 28px 58px rgba(7, 10, 18, 0.3);
  }

  .todo-head h1 {
    margin: 0.25rem 0 0.4rem;
    font-size: clamp(2rem, 4vw, 2.8rem);
  }

  .todo-kicker {
    margin: 0;
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(29, 45, 76, 0.72);
  }

  .todo-details {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition:
      max-height 560ms cubic-bezier(0.2, 0.85, 0.24, 1),
      opacity 340ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .todo-card.is-expanded .todo-details {
    margin-top: 18px;
    opacity: 1;
  }

  .todo-details ul {
    margin: 0.45rem 0 0;
    padding-left: 1.25rem;
  }

  .todo-details li {
    margin: 0.45rem 0;
    line-height: 1.55;
  }

  .todo-group {
    margin: 0.5rem 0;
    border: none;
    border-radius: 12px;
    padding: 0.45rem 0.7rem 0.55rem;
    background: rgba(255, 255, 255, 0);
  }

  .todo-group summary {
    cursor: pointer;
    font-weight: 700;
    line-height: 1.35;
    list-style: none;
  }

  .todo-group summary::-webkit-details-marker {
    display: none;
  }

  .todo-group summary::before {
    content: "▸";
    display: inline-block;
    margin-right: 0.45rem;
    transition: transform 220ms cubic-bezier(0.2, 0.85, 0.24, 1);
  }

  .todo-group[open] > summary::before {
    transform: rotate(90deg);
  }

  .todo-group.nested {
    margin-top: 0.7rem;
    margin-left: 0.4rem;
    border: none;
    background: rgba(255, 255, 255, 0);
  }

  @media (max-width: 768px) {
    .home-panels {
      gap: 14px;
      flex-wrap: wrap;
      align-items: center;
    }

    .home-todo {
      min-height: 320px;
    }

    .todo-card {
      border-radius: 20px;
      min-height: 220px;
      padding: 20px 16px 16px;
    }

    .home-link-card {
      width: min(260px, calc(100vw - 104px));
      height: 380px;
      border-radius: 20px;
    }

    .home-link-card__inner {
      padding: 20px 16px 16px;
    }

    .home-link-card__terminal-screen {
      padding: 0.9rem 0.9rem 0.95rem;
    }

    .home-link-card__content {
      padding-top: 1rem;
    }

    .todo-card.is-expanded {
      min-height: 300px;
      padding-bottom: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .todo-backdrop,
    .todo-card,
    .home-link-card,
    .home-link-card__terminal::after,
    .home-link-card::after,
    .todo-details,
    .todo-group summary::before {
      transition: none;
      animation: none;
    }
  }
</style>

<script>
  const setupTiltCard = (card, canTilt = () => true) => {
    if (!(card instanceof HTMLElement)) {
      return;
    }
    if (card.dataset.tiltReady === "true") {
      return;
    }
    card.dataset.tiltReady = "true";

    const maxTilt = 8;
    const followStrength = 0.14;
    const restThreshold = 0.02;
    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;
    let rafId = 0;

    const renderTilt = () => {
      card.style.setProperty("--rotate-x", `${currentX}deg`);
      card.style.setProperty("--rotate-y", `${currentY}deg`);
    };

    const animateTilt = () => {
      currentX += (targetX - currentX) * followStrength;
      currentY += (targetY - currentY) * followStrength;
      renderTilt();

      const dx = Math.abs(targetX - currentX);
      const dy = Math.abs(targetY - currentY);
      if (dx > restThreshold || dy > restThreshold) {
        rafId = window.requestAnimationFrame(animateTilt);
        return;
      }
      currentX = targetX;
      currentY = targetY;
      renderTilt();
      rafId = 0;
    };

    const ensureTiltAnimation = () => {
      if (rafId !== 0) {
        return;
      }
      rafId = window.requestAnimationFrame(animateTilt);
    };

    card.addEventListener("mousemove", (event) => {
      if (!canTilt()) {
        return;
      }
      const rect = card.getBoundingClientRect();
      const px = (event.clientX - rect.left) / rect.width - 0.5;
      const py = (event.clientY - rect.top) / rect.height - 0.5;
      targetX = -py * maxTilt;
      targetY = px * maxTilt;
      ensureTiltAnimation();
    });

    card.addEventListener("mouseleave", () => {
      targetX = 0;
      targetY = 0;
      ensureTiltAnimation();
    });
  };

  const setupTodoCard = () => {
    const card = document.querySelector("[data-todo-card]");
    const detail = document.querySelector("[data-todo-details]");
    const backdrop = document.querySelector("[data-todo-backdrop]");
    if (!(card instanceof HTMLElement) || !(detail instanceof HTMLElement) || !(backdrop instanceof HTMLElement)) {
      return;
    }
    if (card.dataset.ready === "true") {
      return;
    }
    card.dataset.ready = "true";

    let closeTimer = 0;
    setupTiltCard(card, () => !card.classList.contains("is-expanded"));

    const syncDetailHeight = () => {
      if (!card.classList.contains("is-expanded")) {
        return;
      }
      detail.style.maxHeight = detail.scrollHeight + "px";
    };

    const closeCard = () => {
      if (!card.classList.contains("is-expanded")) {
        return;
      }
      if (closeTimer !== 0) {
        window.clearTimeout(closeTimer);
        closeTimer = 0;
      }
      detail.style.maxHeight = detail.scrollHeight + "px";
      requestAnimationFrame(() => {
        detail.style.maxHeight = "0px";
        detail.style.opacity = "0";
      });
      card.classList.remove("is-expanded");
      card.setAttribute("aria-expanded", "false");
      backdrop.classList.remove("is-active");
      card.style.setProperty("--rotate-x", "0deg");
      card.style.setProperty("--rotate-y", "0deg");
      closeTimer = window.setTimeout(() => {
        if (!card.classList.contains("is-expanded")) {
          detail.hidden = true;
        }
        closeTimer = 0;
      }, 560);
    };

    const openCard = () => {
      if (closeTimer !== 0) {
        window.clearTimeout(closeTimer);
        closeTimer = 0;
      }
      detail.hidden = false;
      detail.style.maxHeight = "0px";
      requestAnimationFrame(() => {
        syncDetailHeight();
        detail.style.opacity = "1";
      });
      card.classList.add("is-expanded");
      card.setAttribute("aria-expanded", "true");
      backdrop.classList.add("is-active");
      card.style.setProperty("--rotate-x", "0deg");
      card.style.setProperty("--rotate-y", "0deg");
    };

    const toggleCard = () => {
      if (card.classList.contains("is-expanded")) {
        closeCard();
      } else {
        openCard();
      }
    };

    card.addEventListener("click", (event) => {
      const target = event.target;
      if (target instanceof Element && target.closest("[data-todo-details]")) {
        return;
      }
      toggleCard();
    });
    card.addEventListener("keydown", (event) => {
      const target = event.target;
      if (target instanceof Element && target.closest("[data-todo-details]")) {
        if (event.key === "Escape") {
          closeCard();
        }
        return;
      }
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        toggleCard();
      }
      if (event.key === "Escape") {
        closeCard();
      }
    });
    backdrop.addEventListener("click", closeCard);
    detail.addEventListener("click", (event) => {
      event.stopPropagation();
    });
    detail.querySelectorAll("details").forEach((item) => {
      item.addEventListener("toggle", syncDetailHeight);
    });
  };

  const setupHomeLinkCard = () => {
    const card = document.querySelector("[data-link-card]");
    setupTiltCard(card);
  };

  setupTodoCard();
  setupHomeLinkCard();
  document.addEventListener("astro:page-load", setupTodoCard);
  document.addEventListener("astro:page-load", setupHomeLinkCard);
</script>
